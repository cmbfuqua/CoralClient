# CoralClient Environment Variables

# Application Settings
FLASK_ENV=development
PORT=8080
SECRET_KEY=your_secret_key_here

# Database Settings
# For local dev, SQLite is used by default if FLASK_ENV=development
# For production (MySQL):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_db_password
DB_NAME=CoralClientSeller
INSTANCE_CONNECTION_NAME=your_gcp_project:us-west3:your_cloud_sql_instance

# SQLAlchemy Pool Settings
DB_POOL_SIZE=10
DB_POOL_RECYCLE=1800
DB_MAX_OVERFLOW=20

# Google Cloud Storage
GOOGLE_APPLICATION_CREDENTIALS=corals4cheap-65a82a68dbed.json
UPLOAD_FOLDER=/data

# Mail Settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# ReCaptcha Settings
RECAPTCHA_PUBLIC_KEY=your_public_key
RECAPTCHA_PRIVATE_KEY=your_private_key
